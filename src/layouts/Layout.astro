---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="The most comprehensive datasets for remote vital sign measurement (rPPG), trusted by leading researchers and companies worldwide. Access high-quality data for contactless vital sign monitoring research." />
    <meta name="keywords" content="rPPG, remote photoplethysmography, vital signs, medical datasets, contactless monitoring, heart rate measurement, SpO2 measurement, research data, medical research, biomedical engineering" />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="VitalVideos Research Team" />
    <meta property="og:title" content="VitalVideos - Remote Vital Sign Measurement Datasets" />
    <meta property="og:description" content="Access comprehensive datasets for remote vital sign measurement (rPPG) research and development." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>